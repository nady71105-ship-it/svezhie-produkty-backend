# Скопируйте в .env и заполните своими значениями. Настоящий .env в git не коммитим.

# Строка подключения к Postgres — берётся в Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Токен бота — берётся у @BotFather в Telegram после /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Публичный HTTPS-адрес backend после деплоя на Railway, например:
# https://svezhie-produkty-production.up.railway.app
PUBLIC_BASE_URL=https://replace-me.up.railway.app

# Адрес самого мини-аппа (фронтенда), который открывается кнопкой в боте.
# Пока фронтенд не задеплоен — можно оставить как PUBLIC_BASE_URL.
MINIAPP_URL=https://replace-me.up.railway.app

# Любая длинная случайная строка — секрет для входа в /admin/* эндпоинты
# (админ-панель отправляет её в заголовке x-admin-token)
ADMIN_TOKEN=придумайте-длинную-случайную-строку

# Порт, на котором слушает backend (Railway подставит свой автоматически через $PORT)
PORT=3000
